# Server
HOST=127.0.0.1
PORT=8787

# Storage: file | codeberg
STORAGE=file

# Used when STORAGE=file
# Path to the consolidated state snapshot; the journal is stored in
# `<snapshot directory>/journal/NNNNNN.json` (one JSON file per operation).
DATABASE_FILE=./data/database.json

# Used when STORAGE=codeberg
CODEBERG_API=https://codeberg.org/api/v1
CODEBERG_OWNER=your-user
CODEBERG_REPO=your-database-repo
CODEBERG_BRANCH=main
# Path to the snapshot (consolidated state) in the repository. If
# snapshot.json does not exist yet, loading falls back to the legacy
# database.json layout.
CODEBERG_FILE=snapshot.json
# Journal directory inside the repository (one operation per file and commit).
# Default: `<CODEBERG_FILE directory>/journal`.
#CODEBERG_JOURNAL=journal
CODEBERG_TOKEN=your-access-token

# Write queue (publishes journal ops one by one, in the background)
WRITE_QUEUE_DEBOUNCE_MS=2000
WRITE_QUEUE_INTERVAL_MS=5000

# Journal: consolidates state into the snapshot every N published operations
JOURNAL_SNAPSHOT_EVERY=10

# Journal: deletes (compacts) entries already consolidated into the snapshot
# after each snapshot (1 commit on Codeberg). Disable with "false".
#JOURNAL_COMPACT=false

# Codeberg: grouped download of pending journal entries at startup (archive ZIP
# in 1 request; fallback to individual requests with N concurrency).
#CODEBERG_JOURNAL_CONCURRENCY=8

# API protection
API_TOKEN=

# --- Serverless deployments (Vercel, Netlify...) ---
# These platforms require STORAGE=codeberg: serverless instances have no
# persistent disk and can freeze between requests. Mutations commit to the
# journal *before* answering the client (`persisted: true`, no async queue).
#
# Optional: cache the loaded state for this many milliseconds when several
# requests land on the same warm instance (0 = revalidate on every request).
#SERVERLESS_CACHE_MS=0
